# Copy as .env (cp .env.example .env); docker compose reads it. Every value has the same default
# in compose.yaml. Ports do not overlap with the Web kit: both can run on one machine.

API_PORT=8000
POSTGRES_PORT=5433
KAFKA_HOST_PORT=9095
KAFKA_UI_PORT=8185
RAY_DASHBOARD_PORT=8265
SPARK_MASTER_UI_PORT=8280
SPARK_JOB_UI_PORT=4040
SPARK_STREAM_UI_PORT=4041
SPARK_HISTORY_PORT=18080
ETCD_PORT=2379
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

API_TOKEN=dev-token

# The client page runs outside Compose on this origin (CORS of api).
CLIENT_ORIGIN=http://localhost:8083

# Topic of your card; one partition for the ordered experiment O5.3.
EVENTS_TOPIC=gate-events
EVENTS_PARTITIONS=3

# Experiment modes; the skeleton reads them in api/app/config.py and spark/jobs/*.py.
QUEUE_CAPACITY=50
WORKERS=4
RESOURCE_MODE=locked
EXECUTION=local
IN_FLIGHT_LIMIT=8
RECEIVER_DELAY_MS=0
SPARK_AQE=on
BROADCAST_THRESHOLD=10m
WATERMARK_MINUTES=10
LEASE_TTL_S=5
FENCING=on

APP_TAG=dev
